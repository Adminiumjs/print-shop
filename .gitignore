# Scratch output of the provenance build in src/builtOutput.test.ts — the same
# bundle with sourcemaps on, used only to prove which chunks are 100% dependency
# code. Never served, never shipped.
.provenance
*.tsbuildinfo
.DS_Store
*.local
.vercel
# .env holds a real ADMINIUM_SECRET — README and .env.example both tell the
# reader to put one there, so it must never be committable by a stray `git add`.
.env
.env.*
!.env.example
