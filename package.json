{
  "name": "print-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Print Shop \u2014 an open-source print-ordering and works-floor example app for Adminium.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "dev:hosted": "VITE_ADMINIUM_SURFACE_SIDE=staff vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --base=/demo/print-shop/",
    "preview": "vite preview",
    "test": "vitest run",
    "add-ons:status": "bash scripts/sync-add-ons.sh status",
    "add-ons:sync": "bash scripts/sync-add-ons.sh sync",
    "demo:status": "node db/demo.mjs status",
    "demo:import": "node db/demo.mjs import",
    "demo:wipe": "node db/demo.mjs wipe",
    "demo:reset": "node db/demo.mjs reset"
  },
  "dependencies": {
    "@adminiumjs/public-client": "^0.2.2",
    "lucide-react": "^0.462.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.9",
    "zod": "^4.4.3"
  }
}
