{
  "name": "print-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Print Shop — an open-source print-ordering and works-floor example app for Adminium.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "dev:hosted": "VITE_ADMINIUM_SURFACE_SIDE=staff vite",
    "dev:staff": "VITE_ADMINIUM_SURFACE_SIDE=staff vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --base=/demo/print-shop/",
    "build:surface:customer": "VITE_ADMINIUM_SURFACE_SIDE=customer tsc -b && VITE_ADMINIUM_SURFACE_SIDE=customer vite build --base=/apps/printing/customer/ --outDir dist-surface/printing/customer",
    "build:surface:staff": "VITE_ADMINIUM_SURFACE_SIDE=staff tsc -b && VITE_ADMINIUM_SURFACE_SIDE=staff vite build --base=/apps/printing/staff/ --outDir dist-surface/printing/staff",
    "preview": "vite preview",
    "test": "vitest run",
    "contract": "CONTRACT=1 vitest run src/contract/",
    "add-ons:status": "bash scripts/sync-add-ons.sh status",
    "add-ons:sync": "bash scripts/sync-add-ons.sh sync",
    "typecheck": "tsc -b",
    "manifest": "vite-node scripts/write-manifest.ts",
    "manifest:check": "vite-node scripts/check-manifest.ts",
    "sample": "vite-node scripts/write-sample.ts",
    "sync:customiser": "node scripts/sync-customiser.mjs"
  },
  "dependencies": {
    "@adminiumjs/public-client": "^0.3.43",
    "lucide-react": "^0.462.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.9",
    "zod": "^4.4.3"
  }
}
